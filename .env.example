# Wasp — variables d’environnement
# Copier ce fichier vers .env.development.local ou .env.production.local.
# Ne jamais committer un fichier .env contenant de vraies valeurs.

# -----------------------------------------------------------------------------
# OBLIGATOIRE — base de données PostgreSQL / Neon
# -----------------------------------------------------------------------------
# La chaîne doit être une URL valide, avec sslmode=require pour Neon.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# -----------------------------------------------------------------------------
# OBLIGATOIRE — Better Auth
# -----------------------------------------------------------------------------
# Secret aléatoire d’au moins 32 caractères.
# Génération possible : openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# URL publique de l’application.
# Local : http://localhost:3000
# Production : https://votre-domaine.example
BETTER_AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OBLIGATOIRE — connexion Google (unique méthode d’authentification)
# -----------------------------------------------------------------------------
# Google Cloud Console → identifiants OAuth 2.0.
# URI de redirection autorisée :
#   http://localhost:3000/api/auth/callback/google
#   https://votre-domaine.example/api/auth/callback/google
# Scopes : openid, email, profile.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# OPTIONNEL mais recommandé — Redis / Upstash
# -----------------------------------------------------------------------------
# Utilisé par :
#   - la limitation du nombre d’essais du code des liens privés (obligatoire en production) ;
#   - le rate limiting général des endpoints (en l’absence, les limiteurs échouent ouverts).
# Sans ces deux valeurs, les liens privés avec code renvoient 503.
KV_REST_API_URL=https://your-upstash-redis-rest-endpoint.upstash.io
KV_REST_API_TOKEN=your-upstash-redis-rest-token

# -----------------------------------------------------------------------------
# OPTIONNEL — origines de déploiement reconnues par Better Auth
# -----------------------------------------------------------------------------
# Fournies automatiquement par Vercel ; à renseigner seulement si nécessaire.
VERCEL_URL=your-vercel-deployment-hostname
VERCEL_PROJECT_PRODUCTION_URL=your-vercel-production-hostname

# Fournies automatiquement dans l’environnement v0 ; à laisser vides en local.
V0_RUNTIME_URL=https://your-v0-runtime.example
V0_DEV_APP_URL=https://your-v0-dev-app.example
V0_BUILD_URL=https://your-v0-build.example
V0_SANDBOX_URL=https://your-v0-sandbox.example

# -----------------------------------------------------------------------------
# GÉRÉ PAR LE RUNTIME — ne pas mettre dans le fichier local
# -----------------------------------------------------------------------------
# NODE_ENV est positionné par Next.js (development | production | test).
# NODE_ENV=development

# CI uniquement — positionné par GitHub Actions pour Playwright.
# CI=true

# Secret GitHub Actions uniquement — utilisé par gitleaks dans la CI.
# Ne pas le copier dans un fichier .env local.
# GITHUB_TOKEN=github-provided-token
