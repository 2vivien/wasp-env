#!/usr/bin/env sh

npx --no-install lint-staged

STAGED_ENV_FILES=$(git diff --cached --name-only | grep -E '(^|/)\.env(\.|$)|(\.env\.(local|production|development))' | grep -v '^\.env\.example$' || true)

if [ -n "$STAGED_ENV_FILES" ]; then
  echo 'Refus: un fichier denvironnement reel est inclus dans le commit.'
  exit 1
fi
